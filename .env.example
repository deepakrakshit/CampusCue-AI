# Server Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Gemini API Keys (4 keys for 4 Live AI participants)
# GEMINI_API_KEY_1 is also used for post-session evaluators (gemini-3.5-flash-lite and gemma-4-26b-a4b-it)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# Model Configuration
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_EVAL_MODEL=gemini-3.5-flash-lite
GEMINI_REVIEW_MODEL=gemma-4-26b-a4b-it

# Database Configuration (SQLite by default for dev, PostgreSQL for production)
DATABASE_URL=
